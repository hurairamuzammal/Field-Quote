bble D","name":"JS: Technicians"},"bTKHM":{"properties":{"height":1,"left":30,"top":30,"width":1,"zindex":2,"AAQ":{"entries":{"0":"jobs"},"type":"TextExpression"},"AAR":true,"AAS":true,"AAT":"text","order":6,"collapse_when_hidden":true},"type":"1488796042609x768734193128308700-AAP","id":"bTKHK","current_parent":"bTGWb1","default_name":"JavascripttoBubble E","name":"JS: Jobs"},"bTKHS":{"properties":{"height":1,"left":20,"top":20,"width":1,"zindex":2,"AAQ":{"entries":{"0":"live"},"type":"TextExpression"},"AAR":true,"AAS":true,"AAT":"boolean","order":7,"collapse_when_hidden":true},"type":"1488796042609x768734193128308700-AAP","id":"bTKHQ","current_parent":"bTGWb1","default_name":"JavascripttoBubble F","name":"JS: Live"},"bTKHc":{"properties":{"height":150,"left":0,"top":0,"width":280,"zindex":3,"html":{"entries":{"0":"<script type=\"module\">\nimport { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm';\n\nconst SUPABASE_URL = 'https://chqljfdmgdtsmbbwbdyv.supabase.co';\nconst ANON_KEY = 'sb_publishable_FWny3Xlw7lXkBJzpNhScAA_qD74Oubw';\n\nwindow.__fqRealtime = window.__fqRealtime || {};\n\nfunction setLive(isLive) {\n  if (typeof bubble_fn_live === 'function') bubble_fn_live(!!isLive);\n}\n\nfunction bindNetworkListeners() {\n  if (window.__fqLiveNetBound) return;\n  window.__fqLiveNetBound = true;\n\n  window.addEventListener('offline', function () {\n    setLive(false);\n  });\n\n  window.addEventListener('online', function () {\n    setLive(false);\n    var rt = window.__fqRealtime;\n    if (rt && rt.lastJwt && typeof rt.start === 'function') {\n      rt.start(rt.lastJwt, rt.lastRole);\n    }\n  });\n}\n\nwindow.__fqRealtime.start = function (jwt, role) {\n  if (!jwt) {\n    setLive(false);\n    return;\n  }\n\n  bindNetworkListeners();\n\n  if (!navigator.onLine) {\n    window.__fqRealtime.lastJwt = jwt;\n    window.__fqRealtime.lastRole = role || '';\n    setLive(false);\n    return;\n  }\n\n  window.__fqRealtime.lastJwt = jwt;\n  window.__fqRealtime.lastRole = role || '';\n\n  const r = (role || '').toLowerCase();\n\n  if (window.__fqRealtime.sb && window.__fqRealtime.channel) {\n    try {\n      window.__fqRealtime.sb.removeChannel(window.__fqRealtime.channel);\n    } catch (e) {}\n  }\n\n  setLive(false);\n\n  const sb = createClient(SUPABASE_URL, ANON_KEY);\n  sb.realtime.setAuth(jwt);\n\n  let ch = sb.channel('staff-ops-' + r);\n\n  if (r === 'admin') {\n    ch = ch\n      .on('postgres_changes', { event: '*', schema: 'public', table: 'requests' },\n        (p) => { if (typeof bubble_fn_requests === 'function') bubble_fn_requests(JSON.stringify(p)); })\n      .on('postgres_changes', { event: '*', schema: 'public', table: 'quotes' },\n        (p) => { if (typeof bubble_fn_quotes === 'function') bubble_fn_quotes(JSON.stringify(p)); })\n      .on('postgres_changes', { event: '*', schema: 'public', table: 'price_book_items' },\n        (p) => { if (typeof bubble_fn_pricebook === 'function') bubble_fn_pricebook(JSON.stringify(p)); })\n      .on('postgres_changes', { event: '*', schema: 'public', table: 'profiles' },\n        (p) => { if (typeof bubble_fn_techs === 'function') bubble_fn_techs(JSON.stringify(p)); })\n      .on('postgres_changes', { event: '*', schema: 'public', table: 'payments' },\n        (p) => { if (typeof bubble_fn_payments === 'function') bubble_fn_payments(JSON.stringify(p)); })\n      .on('postgres_changes', { event: '*', schema: 'public', table: 'jobs' },\n        (p) => { if (typeof bubble_fn_jobs === 'function') bubble_fn_jobs(JSON.stringify(p)); });\n  } else if (r === 'technician') {\n    ch = ch\n      .on('postgres_changes', { event: '*', schema: 'public', table: 'jobs' },\n        (p) => { if (typeof bubble_fn_jobs === 'function') bubble_fn_jobs(JSON.stringify(p)); });\n  } else {\n    window.__fqRealtime.sb = sb;\n    window.__fqRealtime.channel = null;\n    setLive(false);\n    return;\n  }\n\n  ch.subscribe(function (status) {\n    if (status === 'SUBSCRIBED') {\n      setLive(true);\n    } else if (\n      status === 'CLOSED' ||\n      status === 'CHANNEL_ERROR' ||\n      status === 'TIMED_OUT'\n    ) {\n      setLive(false);\n    }\n  });\n\n  window.__fqRealtime.channel = ch;\n  window.__fqRealtime.sb = sb;\n};\n\nbindNetworkListeners();\n</script>"},"type":"TextExpression"},"is_visible":true,"order":1,"fit_height":true,"single_width":true,"min_width_css":"0px","single_height":false,"max_height_css":"0px","min_height_css":"0px","horiz_alignment":"flex-start","collapse_when_hidden":true},"type":"HTML","id":"bTKHX","default_name":"HTML A","name":"HTML: Auth","style":"HTML_default_"},"bTLHh":{"properties":{"height":1,"left":0,"top":0,"width":1,"zindex":4,"AAQ":{"entries":{"0":"payments"},"type":"TextExpression"},"AAR":true,"AAS":true,"AAT":"text","order":8,"collapse_when_hidden":true},"type":"1488796042609x768734193128308700-AAP","id":"bTLHf","default_name":"JavascripttoBubble G","name":"JS: Payment"}},"name":"RE: SessionKeeper","style":"Group_transparent_","workflows":{"bTGhf":{"properties":{"condition":{"next":{"next":{"args":{"next":{"next":{"type":"Message","name":"is_not_empty","is_slidable":false},"type":"Message","name":"sb_refresh_token_text","is_slidable":false},"type":"CurrentUser","is_slidable":false},"next":{"args":{"next":{"args":5,"next":{"args":{"next":{"type":"Message","name":"sb_expires_at_date","is_slidable":false},"type":"CurrentUser","is_slidable":false},"type":"Message","name":"greater_than","is_slidable":false},"type":"Message","name":"plus_minutes","is_slidable":false},"properties":{"name":"Current Date/Time"},"type":"PageData","is_slidable":false},"type":"Message","name":"and_","is_slidable":false},"type":"Message","name":"and_","is_slidable":false},"type":"Message","name":"logged_in","is_slidable":false},"type":"CurrentUser","is_slidable":false},"interval":3000,"workflow_disabled":false},"type":"DoInterval","id":"bTGhT","actions":{"0":{"properties":{"condition":{"next":{"args":5,"next":{"args":{"next
ght_css":"40px","horiz_alignment":"flex-start","container_layout":"row","collapse_when_hidden":true,"container_horiz_alignment":"space-between"},"type":"Group","id":"bTHtD","current_parent":"bTGUL1","default_name":"Group J","elements":{"bTGww":{"properties":{"text":{"entries":{"0":"Company Logo"},"type":"TextExpression"},"height":36,"left":0,"top":0,"width":100,"zindex":15,"order":2,"fit_width":true,"fit_height":true,"single_width":false,"min_width_css":"300px","single_height":false,"min_height_css":"0px","vert_alignment":"center","horiz_alignment":"flex-start","collapse_when_hidden":true},"type":"Text","id":"bTHtE","default_name":"Text H","name":"Text: Company Logo Label","style":"Text_body_16_"},"bTHBS":{"properties":{"height":240,"left":0,"top":292,"width":320,"zindex":6,"src":{"entries":{"0":{"next":{"next":{"type":"Message","name":"logo_url_text","is_slidable":false},"type":"Message","name":"first_element","is_slidable":false},"properties":{"type_to_find":"custom.brand"},"type":"Search"}},"type":"TextExpression"},"order":3,"fit_height":true,"single_width":true,"min_width_css":"150px","single_height":false,"min_height_css":"240px","vert_alignment":"center","horiz_alignment":"flex-start","use_aspect_ratio":true,"collapse_when_hidden":true},"type":"Image","id":"bTHtI","default_name":"Image A","name":"Image: Company Logo","style":"Image_standard_image_"},"bTTvZ":{"properties":{"height":150,"left":694.5,"top":30.71875,"width":280,"zindex":17,"html":{"entries":{"0":"<div id=\"fq-logo-root\" style=\"width:100%;display:flex;flex-direction:column;gap:8px;align-items:flex-start;\">\n  <label id=\"fq-logo-btn\" for=\"fq-logo-file\"\n    style=\"position:relative;display:inline-block;cursor:pointer;border:0;border-radius:8px;padding:10px 16px;background:#0B1D2C;color:#fff;font-size:14px;line-height:1.2;\">\n    Change logo\n    <input id=\"fq-logo-file\" type=\"file\" accept=\"image/png,image/jpeg,image/webp,image/svg+xml,.png,.jpg,.jpeg,.webp,.svg\"\n      style=\"position:absolute;left:0;top:0;width:100%;height:100%;opacity:0;cursor:pointer;font-size:0;\" />\n  </label>\n  <div id=\"fq-logo-status\" style=\"font-size:13px;color:#5B6B7A;\"></div>\n</div>\n<script>\n(function () {\n  if (window.__fqLogoChangeBound) return;\n  window.__fqLogoChangeBound = true;\n  document.addEventListener('change', function (e) {\n    var input = e.target;\n    if (!input || input.id !== 'fq-logo-file') return;\n    var file = input.files && input.files[0];\n    input.value = '';\n    if (!file) return;\n    window.fqUploadCompanyLogo(window.__fqLogoOpts || {}, file, document.getElementById('fq-logo-status'));\n  }, true);\n})();\n\nwindow.fqInitLogoUploader = function (opts) {\n  window.__fqLogoOpts = opts || {};\n};\n\nwindow.fqUploadCompanyLogo = async function (opts, file, statusEl) {\n  var setStatus = function (t, ok) {\n    if (!statusEl) return;\n    statusEl.style.color = ok === false ? '#c0392b' : '#5B6B7A';\n    statusEl.textContent = t || '';\n  };\n  opts = opts || window.__fqLogoOpts || {};\n  var token = String(opts.accessToken || '').trim();\n  if (token.toLowerCase().indexOf('bearer ') === 0) token = token.slice(7).trim();\n  if (!token || !opts.apikey || !opts.presignUrl) {\n    setStatus('Missing token or apikey', false);\n    return;\n  }\n  if (token.indexOf('eyJ') !== 0) {\n    setStatus('Bad token — quotes around the blue pill only, no <<< >>>', false);\n    return;\n  }\n  var name = String(file.name || 'logo.png');\n  var ext = (name.split('.').pop() || '').toLowerCase();\n  if (['jpg', 'jpeg', 'png', 'webp', 'svg'].indexOf(ext) < 0) {\n    setStatus('Use jpg, png, webp, or svg', false);\n    return;\n  }\n  setStatus('Uploading…');\n  try {\n    var mime = file.type || (ext === 'svg' ? 'image/svg+xml' : 'image/png');\n    var presign = await fetch(opts.presignUrl, {\n      method: 'POST',\n      headers: {\n        apikey: opts.apikey,\n        Authorization: 'Bearer ' + token,\n        'Content-Type': 'application/json'\n      },\n      body: JSON.stringify({\n        fileName: name,\n        contentType: mime,\n        fileSize: file.size,\n        kind: 'logo'\n      })\n    });\n    var body = await presign.json().catch(function () { return {}; });\n    if (!presign.ok) {\n      setStatus(body.error || 'Upload not allowed', false);\n      return;\n    }\n    var put = await fetch(body.url, {\n      method: 'PUT',\n      headers: { 'Content-Type': body.mime || mime },\n      body: file\n    });\n    if (!put.ok) {\n      setStatus('Could not store file', false);\n      return;\n    }\n    if (typeof bubble_fn_logo_key === 'function') bubble_fn_logo_key(body.objectKey);\n    else setStatus('Uploaded but bubble_fn_logo_key missing — Patch did not run', false);\n    setStatus('Saved');\n  } catch (e) {\n    setStatus('Try again later', false);\n  }\n};\n</script>"},"type":"TextExpression"},"order":4,"fit_height":true,"single_width":true,"min_width_css":"280px","single_height":false,"min_height_css":"150px","horiz_alignment":"flex-start","collapse_when_hidden":true},"type":"HTML","id":"bTTvS","default_name":"HTML B","name":" HTML: Logo Upload","style":"HTML_default_"}},"name":"G: Company Form Header","style":"Group_transparent_"},"bTISe":{"properties":{"height":0,"left":0,"top":-62.15625,"width":0,"zindex":16,"data_source":{"type":"ElementParent","is_slidable":false},"group_type":"api.apiconnector2.bTGOS1.bTHVy","order":3,"use_gap":true,"fit_width":false,"column_gap":100,"fit_height":true,"single_width":false,"min_width_css":"40px","single_height":false,"min_height_css":"40px","horiz_alignment":"flex-start","container_layout":"row","collapse_when_hidden":true,"container_horiz_alignment":"flex-start"},"type":"Group","id":"bTHth","current_parent":"bTGxW","default_name":"Group J","elements":{"bTGww":{"properties":{"text":{"entries":{"0":"Company Name"},"type":"TextExpression"},"height":36,"left":0,"top":0,"width":100,"zindex":15,"order":2,"fit_width":true,"fit_height":true,"single_width":f
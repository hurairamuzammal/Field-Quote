t","is_slidable":false},"properties":{"is_visible":true},"type":"State"}},"type":"Button","id":"bTTSQ","current_parent":"bTRWZ","default_name":"Button E","style":"Button_filled_dark_primary_"},"bTTSo":{"properties":{"text":{"entries":{"0":"Media"},"type":"TextExpression"},"height":36,"left":20,"top":20,"width":100,"zindex":49,"font_color":"var(--color_bTHBc_default)","font_size":18,"order":56,"fit_width":true,"fit_height":true,"font_family":"var(--font_default)","single_width":false,"min_width_css":"0px","single_height":false,"lock_in_editor":false,"min_height_css":"0px","horiz_alignment":"flex-start","collapse_when_hidden":true},"type":"Text","id":"bTTSj","current_parent":"bTRWB","default_name":"Text A","style":"Text_heading_1_copy_copy_"},"bTTSv":{"properties":{"text":{"entries":{"0":"No media uploaded yet..."},"type":"TextExpression"},"height":36,"left":0,"top":0,"width":100,"zindex":50,"is_visible":false,"order":61,"fit_width":true,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"lock_in_editor":false,"min_height_css":"0px","horiz_alignment":"center","collapse_when_hidden":true},"type":"Text","id":"bTTSt","default_name":"Text T","style":"Text_body_16_"},"bTTVJ":{"properties":{"height":0,"left":-24,"top":-27.1875,"width":0,"zindex":47,"data_source":{"type":"ElementParent"},"group_type":"api.apiconnector2.bTGOS1.bTTCb","order":3,"fit_width":true,"unique_id":{"entries":{"0":""},"type":"TextExpression"},"fit_height":true,"single_width":false,"min_width_css":"40px","single_height":false,"lock_in_editor":false,"min_height_css":"40px","horiz_alignment":"center","container_layout":"row","collapse_when_hidden":true,"container_horiz_alignment":"space-between"},"type":"Group","id":"bTRXR","default_name":"Group RZ","elements":{"bTKNK":{"properties":{"text":{"entries":{"0":"Jobs Scheduled"},"type":"TextExpression"},"height":36,"left":-30,"top":-24,"width":100,"zindex":2,"font_color":"var(--color_text_default)","font_size":32,"order":2,"fit_width":true,"unique_id":{"entries":{"0":""},"type":"TextExpression"},"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"lock_in_editor":false,"min_height_css":"0px","horiz_alignment":"center","collapse_when_hidden":true},"states":{"0":{"condition":{"next":{"args":800,"type":"Message","name":"less_than","is_slidable":false},"properties":{"element_id":"bTRDL","name":"Current Page Width"},"type":"PageData","is_slidable":false},"properties":{"font_size":32},"type":"State"}},"type":"Text","id":"bTRXV","default_name":"Text HZZ","name":"Text: Popup Title","style":"Text_heading_1_copy_"}},"name":"G: Popup Heading","style":"Group_transparent_"},"bTTWA":{"properties":{"height":1,"left":0,"top":0,"width":1,"zindex":53,"AAQ":{"entries":{"0":"media"},"type":"TextExpression"},"order":59,"collapse_when_hidden":true},"type":"1488796042609x768734193128308700-AAP","id":"bTTVv","default_name":"JavascripttoBubble A"},"bTTWp":{"properties":{"height":150,"left":229,"top":444,"width":280,"zindex":52,"html":{"entries":{"0":"<input type=\"file\" id=\"fq-job-photos\" accept=\"image/*\" multiple style=\"display:none\">\n<div id=\"fq-job-status\" style=\"font-size:12px;opacity:.8;min-height:16px;margin:0 0 4px\"></div>\n<div id=\"fq-job-thumbs\" style=\"display:flex;flex-wrap:wrap;gap:6px;align-items:center\"></div>\n<script>\nwindow.__fqJob = { jobId: '', accessToken: '', apikey: '', companyId: '', restUrl: '', presignUrl: '' };\nfunction fqJobSay(m) {\n  var el = document.getElementById('fq-job-status');\n  if (el) el.textContent = m || '';\n}\nfunction fqJobCount(n) { try { bubble_fn_jobphotos(n); } catch (e) {} }\nfunction fqJobAuthJson() {\n  return {\n    apikey: window.__fqJob.apikey,\n    Authorization: 'Bearer ' + String(window.__fqJob.accessToken || '').replace(/^Bearer\\s+/i, '').trim(),\n    'Content-Type': 'application/json'\n  };\n}\nfunction fqJobThumb(url) {\n  var a = document.createElement('a');\n  a.href = url;\n  a.target = '_blank';\n  a.rel = 'noopener';\n  a.style.cssText = 'display:block;width:40px;height:40px;border-radius:6px;overflow:hidden;background:#e5e7eb;flex:0 0 40px';\n  var img = document.createElement('img');\n  img.src = url;\n  img.style.cssText = 'width:40px;height:40px;object-fit:cover;display:block';\n  a.appendChild(img);\n  return a;\n}\nwindow.fqJobPickPhotos = function () {\n  var inp = document.getElementById('fq-job-photos');\n  if (inp) inp.click();\n};\nwindow.fqLoadJobMedia = async function (opts) {\n  if (opts) window.__fqJob = Object.assign(window.__fqJob, opts);\n  var thumbs = document.getElementById('fq-job-thumbs');\n  if (!thumbs) return;\n  var j = window.__fqJob;\n  if (!j.jobId || !j.accessToken || !j.apikey) {\n    thumbs.innerHTML = '';\n    fqJobSay('Missing job or token');\n    return;\n  }\n  thumbs.innerHTML = '';\n  fqJobSay('Loading…');\n  try {\n    var listRes = await fetch(\n      j.restUrl + '/job_media?select=id,r2_key,kind,created_at&job_id=eq.' + encodeURIComponent(j.jobId) + '&order=created_at.asc',\n      { headers: { apikey: j.apikey, Authorization: fqJobAuthJson().Authorization } }\n    );\n    if (!listRes.ok) { fqJobSay('List failed ' + listRes.status); return; }\n    var rows = await listRes.json();\n    fqJobCount(rows.length);\n    if (!rows.length) { fqJobSay('No photos yet'); return; }\n    var signed = 0;\n    var lastErr = '';\n    for (var i = 0; i < rows.length; i++) {\n      var signRes = await fetch(j.presignUrl, {\n        method: 'POST',\n        headers: fqJobAuthJson(),\n        body: JSON.stringify({ mode: 'get', key: rows[i].r2_key })\n      });\n      var raw = await signRes.text();\n      var data = {};\n      try { data = JSON.parse(raw); } catch (e) {}\n      if (!signRes.ok || !data.url) {\n        lastErr = 'GET ' + signRes.status + ' ' + (data.error || raw).toString().slice(0, 80);\n        continue;\n      }\n      thumbs.appendChild(fqJobThumb(data.url));\n      signed++;\n    }\n    if (!signed) fqJobSay('Could not sign URLs — ' + lastErr);\n    else fqJobSay(signed + ' photo(s)');\n  } catch (e) {\n    fqJobSay('Load error');\n    console.error(e);\n  }\n};\nasync function fqJobUploadOne(file) {\n  var j = window.__fqJob;\n  var name = file.name || 'photo.jpg';\n  if (!/\\.(jpe?g|png|webp|heic|heif)$/i.test(name)) name += '.jpg';\n  var pres = await fetch(j.presignUrl, {\n    method: 'POST',\n    headers: fqJobAuthJson(),\n    body: JSON.stringify({ fileName: name, kind: 'photo', fileSize: file.size, job_id: j.jobId })\n  });\n  var presText = await pres.text();\n  if (!pres.ok) { fqJobSay('Presign ' + pres.status + ' ' + presText.slice(0, 80)); return null; }\n  var data = JSON.parse(presText);\n  var put = await fetch(data.url, { method: 'PUT', body: file });\n  if (!put.ok) { fqJobSay('R2 PUT ' + put.status); return null; }\n  var ins = await fetch(j.restUrl + '/job_media', {\n    method: 'POST',\n    headers: Object.assign({}, fqJobAuthJson(), { Prefer: 'return=minimal' }),\n    body: JSON.stringify({\n      company_id: j.companyId,\n      job_id: j.jobId,\n      r2_key: data.objectKey,\n      kind: 'completion_photo'\n    })\n  });\n  if (!ins.ok) { fqJobSay('Insert ' + ins.status + ' ' + (await ins.text()).slice(0, 80)); return null; }\n  return URL.createObjectURL(file);\n}\ndocument.addEventListener('change', async function (e) {\n  if (!e.target || e.target.id !== 'fq-job-photos') return;\n  var files = Array.from(e.target.files || []);\n  e.target.value = '';\n  if (!files.length || !window.__fqJob.jobId) return;\n  var thumbs = document.getElementById('fq-job-thumbs');\n  fqJobSay('Uploading…');\n  for (var i = 0; i < files.length; i++) {\n    if (files[i].size > 10 * 1024 * 1024) { fqJobSay(files[i].name + ' over 10MB'); continue; }\n    var blobUrl = await fqJobUploadOne(files[i]);\n    if (blobUrl && thumbs) thumbs.appendChild(fqJobThumb(blobUrl));\n  }\n  await window.fqLoadJobMedia();\n});\n</script>"},"type":"TextExpression"},"order":58,"fit_width":false,"uni
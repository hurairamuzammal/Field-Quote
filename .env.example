# Names only — never commit values.
# Copy to .env.local / set via `supabase secrets set` / Vercel env as appropriate.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Landing waitlist (preferred — server-only, avoids Vercel NEXT_PUBLIC warning):
#   SUPABASE_URL=https://chqljfdmgdtsmbbwbdyv.supabase.co
#   SUPABASE_ANON_KEY=<anon JWT or sb_publishable_…>
# Edge: `npx supabase functions deploy submit-waitlist --no-verify-jwt`

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Z.AI GLM — primary for draft-quote (fallback = OpenRouter)
# Free vision default: glm-4.6v-flash (see docs.z.ai pricing)
ZAI_API_KEY=
ZAI_MODEL=

RESEND_API_KEY=
# Verified sender address only (display name comes from company_settings.name)
RESEND_FROM_EMAIL=
# Public Bubble pages for customer quote flow (create-checkout appends ?token=…)
PUBLIC_QUOTE_PAGE_URL=
PUBLIC_QUOTE_SUCCESS_URL=
# Bubble password_setup page base (invite + reset). No query string.
BUBBLE_PASSWORD_SETUP_URL=
# Vercel landing origin for email logo PNG (no trailing slash). Example: https://fieldquote.vercel.app
# Serves /logos/logo-email.png — without this, emails use a text wordmark.
EMAIL_ASSET_BASE_URL=
PUBLIC_LANDING_URL=
# Extra browser origins for edge CORS (comma-separated). Bubble + *.vercel.app already allowed.
CORS_ALLOWED_ORIGINS=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public HTTPS base for company logos (no trailing slash).
# Required for DB logo_key in emails (signed URLs expire in inboxes).
# company-brand UI can sign a private GET when this is unset.
R2_PUBLIC_BASE_URL=

MAKE_WEBHOOK_URL=
CRON_SECRET=

f","name":"Current Page Width"},"type":"PageData","is_slidable":false},"properties":{"use_gap":true,"column_gap":10,"container_horiz_alignment":"center"},"type":"State"}},"type":"Group","id":"bTHHL","default_name":"Group B","elements":{"bTHHS":{"properties":{"text":{"entries":{"0":"Voice Note"},"type":"TextExpression"},"height":44,"left":0,"top":-279.40625,"width":150,"zindex":10,"icon":"material outlined settings_voice","border_color":"var(--color_bTHBX_default)","font_color":"var(--color_text_default)","icon_color":"var(--color_text_default)","background_style":"bgcolor","bgcolor":"var(--color_primary_default)","order":2,"fit_width":true,"fit_height":true,"margin_top":20,"button_type":"label_icon","single_width":false,"margin_bottom":20,"min_width_css":"200px","single_height":false,"min_height_css":"44px","horiz_alignment":"center","collapse_when_hidden":true},"states":{"0":{"condition":{"next":{"args":850,"type":"Message","name":"less_than","is_slidable":false},"properties":{"element_id":"bTGYf","name":"Current Page Width"},"type":"PageData","is_slidable":false},"properties":{"min_width_css":"150px"},"type":"State"}},"type":"Button","id":"bTHHE","current_parent":"bTHGJ","default_name":"Button C","name":"Btn: Voice Note","style":"Button_filled_dark_primary_"},"bTHHW":{"properties":{"text":{"entries":{"0":"Add Images"},"type":"TextExpression"},"height":44,"left":0,"top":-279.40625,"width":150,"zindex":10,"icon":"material outlined broken_image","font_color":"var(--color_text_default)","icon_color":"var(--color_text_default)","background_style":"bgcolor","bgcolor":"var(--color_primary_default)","order":1,"fit_width":true,"fit_height":true,"margin_top":20,"button_type":"label_icon","single_width":false,"margin_bottom":20,"min_width_css":"200px","single_height":false,"min_height_css":"44px","horiz_alignment":"center","collapse_when_hidden":true},"states":{"0":{"condition":{"next":{"args":850,"type":"Message","name":"less_than","is_slidable":false},"properties":{"element_id":"bTGYf","name":"Current Page Width"},"type":"PageData","is_slidable":false},"properties":{"min_width_css":"150px"},"type":"State"}},"type":"Button","id":"bTHFG","default_name":"Button B","name":"Btn: Add Images","style":"Button_filled_dark_primary_"}},"name":"G: Media Actions","style":"Group_transparent_"},"bTHMu":{"properties":{"text":{"entries":{"0":"You may add upto 5 images <10 Mbs or audio upto 20 Mb "},"type":"TextExpression"},"height":36,"left":0,"top":-54.875,"width":100,"zindex":17,"font_size":12,"order":11,"fit_width":true,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","collapse_when_hidden":true},"type":"Text","id":"bTHJP","default_name":"Text E","name":"T: Media Limits","style":"Text_body_16_"},"bTHMy":{"properties":{"height":150,"left":0,"top":-54.875,"width":280,"zindex":13,"html":{"entries":{"0":"<input type=\"file\" id=\"fq-photos\" accept=\"image/*\" multiple style=\"display:none\">\n<input type=\"file\" id=\"fq-audio\" accept=\"audio/*\" style=\"display:none\">\n\n<div id=\"fq-thumbs\" style=\"display:flex;gap:8px;flex-wrap:wrap;margin-top:8px\"></div>\n<div id=\"fq-audio-row\" style=\"margin-top:8px\"></div>\n\n<script>\nconst FN_URL   = \"https://chqljfdmgdtsmbbwbdyv.supabase.co/functions/v1/r2-presign\";\nconst ANON_KEY = \"sb_publishable_FWny3Xlw7lXkBJzpNhScAA_qD74Oubw\";\nconst MAX_FILES = 5, MAX_PHOTO_MB = 10, MAX_AUDIO_MB = 20;\n\nconst say  = (m) => { try { bubble_fn_status(m); } catch(e){ console.log(m); } };\nconst busy = (b) => { try { bubble_fn_busy(b);   } catch(e){} };\n\nlet photos = [];   // [{key, name, size, previewUrl}]\nlet audio  = null; // {key, name, size}\n\n// Hands EVERYTHING to Bubble as one JSON string\nfunction pushMedia() {\n  const all = photos.map(p => ({ key: p.key, kind: 'photo', size: p.size }));\n  if (audio) all.push({ key: audio.key, kind: 'audio', size: audio.size });\n  try { bubble_fn_media(JSON.stringify(all)); } catch(e) { console.log(all); }\n}\n\nwindow.fqPickPhotos = () => document.getElementById('fq-photos').click();\nwindow.fqPickAudio  = () => document.getElementById('fq-audio').click();\n\nasync function uploadOne(file, kind) {\n  const pres = await fetch(FN_URL, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json', 'apikey': ANON_KEY },\n    body: JSON.stringify({\n      fileName: file.name,\n      contentType: file.type || 'application/octet-stream',\n      fileSize: file.size,\n      kind: kind\n    })\n  });\n  if (!pres.ok) { console.log('PRESIGN', pres.status, await pres.text()); return null; }\n  const data = await pres.json();\n\n  const put = await fetch(data.url, { method: 'PUT', body: file });\n  if (!put.ok) { console.log('PUT', put.status, await put.text()); return null; }\n  return data.objectKey;\n}\n\nfunction renderPhotos() {\n  const box = document.getElementById('fq-thumbs');\n  box.innerHTML = '';\n  photos.forEach((p, i) => {\n    const wrap = document.createElement('div');\n    wrap.style.cssText = 'position:relative;width:64px;height:64px';\n    wrap.innerHTML =\n      '<img src=\"' + p.previewUrl + '\" style=\"width:64px;height:64px;object-fit:cover;border-radius:6px\">' +\n      '<button data-i=\"' + i + '\" class=\"fq-rm-photo\" style=\"position:absolute;top:-6px;right:-6px;' +\n      'width:20px;height:20px;border-radius:50%;border:none;background:#c0392b;color:#fff;' +\n      'font-size:12px;line-height:1;cursor:pointer\">&times;</button>';\n    box.appendChild(wrap);\n  });\n  say(photos.length ? photos.length + ' photo(s) attached' : 'No photos attached');\n  pushMedia();\n}\n\nfunction renderAudio() {\n  const row = document.getElementById('fq-audio-row');\n  row.innerHTML = audio\n    ? '<span style=\"font-size:13px\">&#127911; ' + audio.name + '</span>' +\n      '<button id=\"fq-rm-audio\" style=\"margin-left:8px;border:none;background:#c0392b;color:#fff;' +\n      'border-radius:4px;padding:2px 8px;cursor:pointer\">remove</button>'\n    : '';\n  pushMedia();\n}\n\n// Remove buttons (delegated — they're created after page load)\ndocument.addEventListener('click', (e) => {\n  const rm = e.target.closest ? e.target.closest('.fq-rm-photo') : null;\n  if (rm) { photos.splice(Number(rm.dataset.i), 1); renderPhotos(); return; }\n  if (e.target.id === 'fq-rm-audio') { audio = null; renderAudio(); say('Voice recording removed'); }\n});\n\n// THE UPLOAD TRIGGER — fires when files are chosen in either picker\ndocument.addEventListener('change', async (e) => {\n\n  if (e.target.id === 'fq-photos') {\n    const room = MAX_FILES - photos.length;\n    if (room <= 0) { say('Maximum ' + MAX_FILES + ' photos'); e.target.value=''; return; }\n    const files = Array.from(e.target.files).slice(0, room);\n\n    busy(true);\n    for (let i = 0; i < files.length; i++) {\n      const f = files[i];\n      say('Uploading photo ' + (i+1) + ' of ' + files.length + '…');\n      if (f.size > MAX_PHOTO_MB*1024*1024) { say(f.name + ' is over ' + MAX_PHOTO_MB + 'MB — skipped'); continue; }\n      const key = await uploadOne(f, 'photo');\n      if (key) photos.push({ key:key, name:f.name, size:f.size, previewUrl:URL.createObjectURL(f) });\n      else say(f.name + ' failed to upload');\n    }\n    renderPhotos();\n    busy(false);\n    e.target.value = '';\n  }\n\n  if (e.target.id === 'fq-audio') {\n    const f = e.target.files[0];\n    if (!f) return;\n    if (f.size > MAX_AUDIO_MB*1024*1024) { say('Recording is over ' + MAX_AUDIO_MB + 'MB'); e.target.value=''; return; }\n\n    busy(true); say('Uploading voice recording…');\n    const key = await uploadOne(f, 'audio');\n    if (key) { audio = { key:key, name:f.name, size:f.size }; say('Voice recording attached'); }\n    else say('Voice recording failed to upload');\n    renderAudio();\n    busy(false);\n    e.target.value = '';\n  }\n});\n\npushMedia();   // publishes \"[]\" so s_media is never blank\n</script>"},"type":"TextExpression"},"order":16,"fit_height":false,"single_width":true,"min_width_css":"280px","single_height":false,"min_height_css":"1px","horiz_alignment":"flex-start","collapse_when_hidden":true},"type":"HTML","id":"bTHHX","default_name":"HTML B","name":"HTML: Uploader","style":"HTML_default_"},"bTHMz":{"properties":{"text":{"entries":{"0":{"next":{"type":"Message","name":"get_AAV","is_slidable":false},"properties":{"element_id":"bTHFS"},"type":"GetElement","is_slidable":false}},"type":"TextExpression"},"height":36,"left":0,"top":-54.875,"width":100,"zindex":8,"order":12,"fit_width":true,"fit_height":true,"margin_top":0,"single_width":false,"margin_bottom":0,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","collapse_when_hidden":true},"type":"Text","id":"bTHEe","default_name":"Text C","name":"T: Upload Status","style":"Text_body_16_"},"bTHNA":{"properties":{"height":1,"left":0,"top":-54.875,"width":1,"zindex":9,"AAQ":{"entries":{"0":"status"},"type":"TextExpression"},"AAR":true,"AAS":true,"AAT":"text","ABN":false,"order":28,"collapse_when_hidden":true},"type":"1488796042609x768734193128308700-AAP","id":"bTHFS","current_parent":"bTGYf","default_name":"JavascripttoBubble B","name":"JS: Status"},"bTHNE":{"properties":{"height":1,"left":0,"top":-54.875,"width":1,"zindex":18,"AAQ":{"entries":{"0":"media"},"type":"TextExpression"},"AAR":true,"AAS":true,"AAT":"text","order":29,"collapse_when_hidden":true},"type":"1488796042609x768734193128308700-AAP","id":"bTHJW","default_name":"JavascripttoBubble D","name":"JS: Media"},"bTHNF":{"properties":{"height":1,"left":0,"top":-54.875,"width":1,"zindex":16,"AAQ":{"entries":{"0":"busy"},"type":"TextExpression"},"AAR":true,"AAS":true,"AAT":"boolean","order":30,"collapse_when_hidden":true},"type":"1488796042609x768734193128308700-AAP","id":"bTHJI","default_name":"JavascripttoBubble E","name":"JS: Busy"},"bTHNo":{"properties":{"height":1,"left":0,"top":0,"width":1,"zindex":24,"AAQ":{"entries":{"0":"speechstate"},"type":"TextExpression"},"AAR":true,"AAS":true,"AAT":"text","order":31,"collapse_when_hidden":true},"type":"1488796042609x768734193128308700-AAP","id":"bTHNj","default_name":"JavascripttoBubble A","name":"JS: Speech State"},"bTHNv":{"properties":{"height":1,"left":0,"top":0,"width":1,"zindex":25,"AAQ":{"entries":{"0":"speech"},"type":"TextExpression"},"AAR":true,"AAS":true,"AAT":"text","order":27,"collapse_when_hidden":true},"type":"1488796042609x768734193128308700-AAP","id":"bTHNq","default_name":"JavascripttoBubble C","name":"JS: Speech"},"bTHOC":{"properties":{"height":150,"left":0,"top":0,"width":280,"zindex":26,"html":{"entries":{"0":"<style>\n  input#fq-hp { position:absolute !important; left:-9999px !important;\n                width:1px !important; height:1px !important; opacity:0 !important; }\n</style>"},"type":"TextExpression"},"order":32,"fit_width":false,"fit_height":false,"single_width":false,"max_width_css":"1px","min_width_css":"1px","single_height":false,"min_height_css":"1px","horiz_alignment":"flex-start","collapse_when_hidden":true},"type":"HTML","id":"bTHOA","default_name":"HTML A","name":"HTML: Styles","style":"HTML_default_"},"bTHOM":{"properties":{"height":150,"left":10,"top":10,"width":280,"zindex":26,"html":{"entries":{"0":"<script>\nconst dsay = (m) => { try { bubble_fn_speechstate(m); } catch(e){} };\nconst dtxt = (t) => { try { bubble_fn_speech(t);      } catch(e){} };\nlet rec = null, running = false, finalTxt = \"\";\n\nwindow.fqDictateToggle = function (existing) {\n  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;\n  if (!SR) { dsay(\"unsupported\"); return; }\n  if (running) { rec.stop(); return; }\n\n  finalTxt = existing ? existing.trim() + \" \" : \"\";\n  rec = new SR();\n  rec.continuous = true; rec.interimResults = true; rec.lang = 'en-GB';\n\n  rec.onstart  = () => { running = true; dsay(\"Listening… tap to stop\"); };\n  rec.onresult = (e) => {\n    let interim = \"\";\n    for (let i = e.resultIndex; i < e.results.len
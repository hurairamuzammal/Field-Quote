ption Value","style":"Text_body_16_"}},"name":"G: Request Description Row","style":"Group_transparent_"},"bTIxs":{"properties":{"text":{"entries":{"0":"DRAFT WITH AI"},"type":"TextExpression"},"height":44,"left":10,"top":10,"width":150,"zindex":3,"icon":"feather edit-3","font_color":"var(--color_text_default)","icon_color":"var(--color_text_default)","is_visible":false,"order":36,"fit_width":true,"fit_height":true,"margin_top":40,"button_type":"label_icon","font_weight":"900","single_width":false,"min_width_css":"60px","single_height":false,"min_height_css":"44px","horiz_alignment":"center","collapse_when_hidden":true},"states":{"0":{"condition":{"next":{"next":{"type":"Message","name":"is_empty","is_slidable":false},"type":"Message","name":"custom.text_7","is_slidable":false},"properties":{"element_id":"bTGLo1"},"type":"GetElement","is_slidable":false},"properties":{"opacity":50,"button_disabled":true,"title_attribute":{"entries":{"0":{"type":"Empty"},"1":"\"Request id error\""},"type":"TextExpression"}},"type":"State"},"1":{"condition":{"next":{"next":{"type":"Message","name":"is_true","is_slidable":false},"type":"Message","name":"custom.yes___no_1","is_slidable":false},"properties":{"element_id":"bTGLo1"},"type":"GetElement","is_slidable":false},"properties":{"is_visible":false},"type":"State"},"2":{"condition":{"next":{"next":{"type":"Message","name":"is_false","is_slidable":false},"type":"Message","name":"custom.yes___no_1","is_slidable":false},"properties":{"element_id":"bTGLo1"},"type":"GetElement","is_slidable":false},"properties":{"is_visible":true},"type":"State"},"3":{"condition":{"next":{"next":{"args":"quoted","type":"Message","name":"equals","is_slidable":false},"type":"Message","name":"custom.text_14","is_slidable":false},"properties":{"element_id":"bTGLo1"},"type":"GetElement","is_slidable":false},"properties":{"opacity":50,"button_disabled":true,"title_attribute":{"entries":{"0":{"type":"Empty"},"1":"\"User request already Quoted. Please check in quoted section\""},"type":"TextExpression"}},"type":"State"}},"type":"Button","id":"bTIxq","current_parent":"bTIno","default_name":"Button N","name":"Button: Draft With AI","style":"Button_filled_dark_primary_"},"bTJAk":{"properties":{"height":150,"left":20,"top":0,"width":280,"zindex":32,"html":{"entries":{"0":"<div id=\"fq-admin-media\" style=\"display:flex;flex-wrap:wrap;gap:8px;min-height:48px;justify-content:center;align-items:center;\"></div>\n<style>\n  @keyframes fq-spin { to { transform: rotate(360deg); } }\n  .fq-spinner {\n    width:16px;height:16px;border-radius:50%;\n    border:2px solid rgba(0,0,0,.15);\n    border-top-color:rgba(0,0,0,.55);\n    animation:fq-spin .7s linear infinite;\n    display:inline-block;\n  }\n  .fq-thumb {\n    border-radius:8px;cursor:pointer;object-fit:cover;\n    display:flex;align-items:center;justify-content:center;\n  }\n  .fq-audio-thumb {\n    background:#2d2d2d;color:#fff;position:relative;\n  }\n  .fq-audio-thumb svg { width:38%;height:38%; }\n</style>\n<script>\nwindow.fqLoadAdminMedia = async function (opts) {\n  const box = document.getElementById('fq-admin-media');\n  if (!box) return;\n  box.innerHTML = `\n    <span style=\"display:inline-flex;align-items:center;gap:6px;font-size:13px;opacity:.7\">\n      <span class=\"fq-spinner\"></span> Loading media…\n    </span>`;\n  const authHeaders = {\n    apikey: opts.apikey,\n    Authorization: 'Bearer ' + opts.accessToken,\n  };\n  const jsonHeaders = { ...authHeaders, 'Content-Type': 'application/json' };\n  const THUMB_SIZE = 110; // <-- change this to resize thumbnails\n\n  // Simple waveform/speaker icon for audio thumbnails\n  const audioIconSvg = `\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M11 5L6 9H3v6h3l5 4V5z\" fill=\"currentColor\"/>\n      <path d=\"M15.5 8.5a5 5 0 010 7\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n      <path d=\"M18 6a8 8 0 010 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" opacity=\"0.6\"/>\n    </svg>`;\n\n  try {\n    const listUrl = opts.restUrl + '/request_media?select=id,r2_key,kind,size_bytes&request_id=eq.' +\n      encodeURIComponent(opts.requestId) + '&order=created_at.asc';\n    const listRes = await fetch(listUrl, { headers: authHeaders });\n    if (!listRes.ok) throw new Error('list ' + listRes.status);\n    const rows = await listRes.json();\n    if (!rows.length) {\n      box.innerHTML = '<span style=\"font-size:13px\">No photos or audio on this request.</span>';\n      return;\n    }\n\n    // Build all elements first, off-DOM, so nothing pops in one-by-one.\n    const elements = [];\n    const loadPromises = [];\n\n    for (const row of rows) {\n      const signRes = await fetch(opts.presignUrl, {\n        method: 'POST',\n        headers: jsonHeaders,\n        body: JSON.stringify({ mode: 'get', key: row.r2_key }),\n      });\n      if (!signRes.ok) continue;\n      const { url } = await signRes.json();\n      if (!url) continue;\n\n      if (row.kind === 'photo') {\n        const img = document.createElement('img');\n        img.alt = 'photo';\n        img.title = 'Open photo';\n        img.className = 'fq-thumb';\n        img.style.width = THUMB_SIZE + 'px';\n        img.style.height = THUMB_SIZE + 'px';\n        img.onclick = () => window.open(url, '_blank');\n\n        // Wait for actual image load (or error) before we consider it \"ready\"\n        const ready = new Promise((resolve) => {\n          img.onload = resolve;\n          img.onerror = resolve; // don't block forever on a bad image\n        });\n        img.src = url;\n        loadPromises.push(ready);\n        elements.push(img);\n      } else {\n        const btn = document.createElement('button');\n        btn.type = 'button';\n        btn.title = 'Play audio';\n        btn.className = 'fq-thumb fq-audio-thumb';\n        btn.style.width = THUMB_SIZE + 'px';\n        btn.style.height = THUMB_SIZE + 'px';\n        btn.style.border = 'none';\n        btn.innerHTML = audioIconSvg;\n        btn.onclick = () => window.open(url, '_blank');\n        elements.push(btn);\n        // buttons render instantly, nothing to wait for\n      }\n    }\n\n    // Wait for every photo to finish loading before showing anything,\n    // so the spinner doesn't disappear before content is ready.\n    await Promise.all(loadPromises);\n\n    box.innerHTML = '';\n    elements.forEach((el) => box.appendChild(el));\n  } catch (e) {\n    box.innerHTML = '<span style=\"color:#c0392b;font-size:13px\">Could not load media</span>';\n    console.error(e);\n  }\n};\n</script>"},"type":"TextExpression"},"order":30,"fit_width":false,"unique_id":{"entries":{"0":"#fq-admin-media"},"type":"TextExpression"},"fit_height":true,"margin_left":20,"margin_right":20,"padding_left":20,"single_width":false,"min_width_css":"60%","padding_right":20,"single_height":false,"min_height_css":"150px","horiz_alignment":"center","collapse_when_hidden":true},"type":"HTML","id":"bTJAf","default_name":"HTML A","name":"HTML: Media Gallery","style":"HTML_default_"},"bTJAr":{"properties":{"text":{"entries":{"0":""},"type":"TextExpression"},"height":36,"left":186.796875,"top":663.609375,"width":100,"zindex":33,"is_visible":false,"order":31,"fit_width":true,"fit_height":true,"single_width":false,"min_width_css":"0px","single_height":false,"min_height_css":"0px","horiz_alignment":"center","collapse_when_hidden":true},"states":{"0":{"condition":{"next":{"next":{"type":"Message","name":"is_true","is_slidable":false},"type":"Message","name":"custom.text_18","is_slidable":false},"properties":{"element_id":"bTGLo1"},"type":"GetElement","is_slidable":false},"properties":{"text":{"entries":{"0":{"type":"Empty"},"1":"Media is Loading"},"type":"TextExpression"}},"type":"State"}},"type":"Text","id":"bTJAm","default_name":"Text FZZ","name":"Text: Media Loading Status","style":"Text_body_16_"},"bTKKM":{"properties":{"height":0,"left":26.390625
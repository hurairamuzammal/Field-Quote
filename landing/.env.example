# Landing (Next.js) — Vercel / local
# Copy to landing/.env.local for laptop; never commit values.
# Prefer server-only names (waitlist uses /api/waitlist only — no browser Supabase client).

SUPABASE_URL=
# Classic anon JWT (eyJ…) OR new publishable key (sb_publishable_…)
SUPABASE_ANON_KEY=
# Optional alias if you prefer the new name:
# SUPABASE_PUBLISHABLE_KEY=

# Canonical origin for OG tags, sitemap, robots (no trailing slash).
# Production example: https://fieldquote.vercel.app
NEXT_PUBLIC_SITE_URL=
